@model RaceDay.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="rd-heading mb-4">Organiser dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card rd-card stat-card">
            <div class="card-body">
                <div class="text-muted">Events created</div>
                <div class="stat-number">@Model.TotalEvents</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card rd-card stat-card">
            <div class="card-body">
                <div class="text-muted">Total enrolments</div>
                <div class="stat-number">@Model.TotalEnrolments</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card rd-card stat-card">
            <div class="card-body">
                <div class="text-muted">Upcoming events</div>
                <div class="stat-number">@Model.Upcoming.Count</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card rd-card">
            <div class="card-body">
                <h5 class="fw-bold">Enrolments per event</h5>
                @if (!Model.Events.Any())
                {
                    <p class="text-muted mb-0">You have not created any events yet. <a asp-action="CreateEvent">Create your first event</a>.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Event</th><th>Date</th><th class="text-end">Enrolments</th></tr></thead>
                            <tbody>
                                @foreach (var e in Model.Events)
                                {
                                    <tr>
                                        <td><a asp-action="Enrolments" asp-route-eventId="@e.Event.EventID">@e.Event.EventName</a></td>
                                        <td>@e.Event.EventDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-end fw-bold">@e.Enrolments</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card rd-card">
            <div class="card-body">
                <h5 class="fw-bold">Upcoming event dates</h5>
                @if (!Model.Upcoming.Any())
                {
                    <p class="text-muted mb-0">No upcoming events.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var e in Model.Upcoming)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@e.Event.EventName</span>
                                <span class="fw-bold text-nowrap">@e.Event.EventDate.ToString("dd MMM yyyy")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>