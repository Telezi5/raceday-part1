@model RaceDay.Web.Models.EventEntriesViewModel
@{
    ViewData["Title"] = "Enrolments";
}

<a asp-action="Events" class="text-decoration-none">← Back to events</a>
<h2 class="rd-heading my-3">Enrolments: @Model.Event.EventName</h2>

<div class="card rd-card">
    <div class="card-body">
        @if (!Model.Entries.Any())
        {
            <p class="text-muted mb-0">Nobody has enrolled yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Participant</th><th>Category</th><th>Bib</th><th>Enrolled</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Entries)
                        {
                            <tr>
                                <td class="fw-bold">@e.ParticipantName</td>
                                <td>@e.CategoryName</td>
                                <td>@(e.BibNumber ?? "-")</td>
                                <td>@e.EntryDate.ToString("dd MMM yyyy")</td>
                                <td><partial name="_StatusBadge" model="e.PaymentStatus" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div></div>